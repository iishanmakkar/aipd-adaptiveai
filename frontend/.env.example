# Backend API — override per environment. In production / behind a reverse
# proxy or CDN, set this to the PUBLIC backend origin (e.g. https://api.example.com).
# Never point it at an internal compose hostname from a browser.
VITE_API_BASE_URL=http://localhost:8000

# NVIDIA NIM VLM (vision requests go through the backend proxy below,
# which injects NIM_API_KEY server-side - never put a key in a VITE_* var:
# it bakes into the public JS bundle)
VITE_NIM_VLM_URL=http://localhost:8000/v1/chat/completions
VITE_NIM_VLM_MODEL=meta/llama-3.2-11b-vision-instruct
