# Backend API
VITE_API_BASE_URL=http://localhost:8000

# NVIDIA NIM VLM (for /describe-image)
# For local NIM: http://localhost:8000/v1/chat/completions
# For NVIDIA hosted: https://integrate.api.nvidia.com/v1/chat/completions
VITE_NIM_VLM_URL=http://localhost:8000/v1/chat/completions
VITE_NIM_VLM_MODEL=meta/llama-3.2-11b-vision-instruct
VITE_NIM_API_KEY=your-nim-api-key-here

# Mock server (for standalone dev-only fallback — never active in production)
# Real mode is VITE_USE_MOCK=false (default shipped); set true only for isolated UI dev without backend
VITE_USE_MOCK=false
VITE_MOCK_API_URL=http://localhost:3001
VITE_MOCK_DELAY_MS=800