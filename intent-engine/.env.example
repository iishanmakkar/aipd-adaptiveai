# === Intent Engine — copy to .env ===
# NVIDIA NIM — REQUIRED for llm_classify (POST /intent/classify)
# If missing/invalid: falls back to keyword_classify (logs "fallback" in reasoning) but RISK: lower accuracy; if network to NIM down, 5s retry then keyword
# This NIM key only allows meta/llama-3.2-11b-vision-instruct — other nvidia models return 404 for this account
NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NIM_API_KEY=your-nim-api-key
NIM_MODEL=meta/llama-3.2-11b-vision-instruct

# Service
PORT=8001
HOST=0.0.0.0
DEBUG=True

# Context memory — cap = max_turns*2 messages retained per session_id (unbounded growth if too high)
MAX_HISTORY_TURNS=5
# Session store bounds (LRU + TTL): max live sessions, idle expiry in seconds.
MAX_SESSIONS=1000
SESSION_TTL_SECONDS=3600

# Rate limiting keys on the socket peer. Set to 1 ONLY when a trusted reverse
# proxy overwrites X-Forwarded-For; otherwise a client can rotate that header
# and get a fresh bucket per request.
TRUST_PROXY_HEADERS=0
