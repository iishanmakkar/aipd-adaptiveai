# Secrets - never commit real keys (use .env.example as template)
.env
backend/.env
intent-engine/.env
agents/.env
frontend/.env
browser-agent/.env
*.key
*.pem

# Tool artifacts
.mimosa/
.ruff_cache/

# Python
__pycache__/
*.py[cod]
*.pyo
.venv/
venv/
*.egg-info/
.pytest_cache/

# Node
node_modules/
frontend/dist/
frontend/build/

# Data
agents/data/chroma/
*.index
*.log

# OS
.DS_Store
Thumbs.db

# Docker volumes (persisted via named volume, not bind)
postgres_data/

# load-test artifacts
backend/loadtest-*.json

# QA run output (screenshots/logs). Curated evidence lives in docs/qa-assets
# and docs/screenshots instead - do not commit raw run dumps.
qa_out/
frontend/qa_out/

# DB dumps / backups - never commit
*.sql
!backend/alembic/**/*.sql
