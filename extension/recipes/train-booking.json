{
  "id": "train-booking",
  "name": "Train ticket search",
  "hosts": [
    "railyatri.in",
    "irctc.co.in",
    "127.0.0.1",
    "localhost"
  ],
  "matchGoal": [
    "train",
    "ticket",
    "berth",
    "irctc",
    "railyatri"
  ],
  "steps": [
    {
      "intent": "origin",
      "role": "textbox",
      "names": [
        "from",
        "origin",
        "source",
        "departure",
        "boarding"
      ]
    },
    {
      "intent": "destination",
      "role": "textbox",
      "names": [
        "to",
        "destination",
        "arrival"
      ]
    },
    {
      "intent": "journey date",
      "role": "textbox",
      "names": [
        "date",
        "journey date",
        "travel date",
        "departure date"
      ],
      "kinds": [
        "date",
        "text"
      ]
    },
    {
      "intent": "class",
      "role": "combobox",
      "names": [
        "class",
        "coach",
        "berth class",
        "travel class"
      ]
    },
    {
      "intent": "passengers",
      "role": "textbox",
      "names": [
        "passenger name",
        "full name",
        "name"
      ],
      "value": "profile:full name"
    },
    {
      "intent": "search",
      "role": "button",
      "names": [
        "search",
        "find trains",
        "show trains"
      ]
    }
  ],
  "stopAt": [
    "book",
    "pay",
    "purchase",
    "add ticket",
    "proceed to payment"
  ],
  "verifiedOn": [
    "demo/book-tickets.html (this repository's own page)",
    "railyatri.in - PERCEPTION ONLY, 2026-10-24: the live homepage was read by the loaded extension (207 elements, snapshot 16 ms, 91% of names agree with Chrome's own AX tree, gate flagged 'Book Train Tickets'/'Book Bus Tickets'). Read-only proof (docs/proofs/2026-10-24-railyatri); no field was filled and no booking was completed."
  ],
  "notVerifiedOn": [
    "irctc.co.in - never reached; the server refuses automated browsers (ERR_HTTP2_PROTOCOL_ERROR, 2026-10-24) and evading that is refused by design"
  ]
}
