# === AdaptiveAI Backend — copy to .env ===
# Database — REQUIRED for POST /api/query & /api/session (503 if missing/down)
# For Docker: postgresql+asyncpg://postgres:postgres@postgres:5432/adaptiveai
# For local:  postgresql+asyncpg://postgres:postgres@localhost:5432/adaptiveai
SUPABASE_DB_URL=postgresql+asyncpg://user:password@host:5432/database

# JWT — REQUIRED for /auth/login→ JWT creation/verification (500 if missing)
# Generate: openssl rand -hex 32 — must be >=32 chars, else auth fails
JWT_SECRET=your-super-secret-key-min-32-chars-long-generate-with-openssl-rand-hex-32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# NVIDIA NIM — REQUIRED for Policy Engine llm_rewrite and VLM proxy (/v1/chat/completions)
# If missing/ invalid: policy rewrites fallback to raw text, VLM returns 503
# This account only allows meta/llama-3.2-11b-vision-instruct (others 404) — keep as-is
NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NIM_API_KEY=your-nim-api-key
NIM_MODEL=meta/llama-3.2-11b-vision-instruct

# External Services — must match docker-compose service names in Docker, localhost locally
# If wrong: POST /api/query returns 502 Intent/Agent service error (httpx timeout 15s/20s)
INTENT_SERVICE_URL=http://localhost:8001
AGENT_SERVICE_URL=http://localhost:8002

# CORS — REQUIRED in prod (DEBUG=False) else TrustedHost 403
FRONTEND_URL=http://localhost:3000
DEBUG=True

# Policy Engine — clarifying_threshold=3 means ≥3 questions in last 5 → simplify rewrite
CLARIFYING_THRESHOLD=3
CONTEXT_WINDOW_SIZE=5
