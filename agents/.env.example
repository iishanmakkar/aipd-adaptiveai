# === Agents+RAG — copy to .env ===
# LLM Provider — nim|openai|anthropic . RISK: wrong provider needs matching key (NIM_API_KEY vs OPENAI_API_KEY)
LLM_PROVIDER=nim

# NIM / OpenAI LLM — REQUIRED for all 5 agents handle() → llm.chat() (real grounded answer)
# If missing/invalid: handle() raises ValueError, POST /agent/respond returns 500 (not fake answer)
# This key only allows meta/llama-3.2-11b-vision-instruct (used for text+RAG) — keep vision model
LLM_MODEL=meta/llama-3.2-11b-vision-instruct
LLM_API_KEY=your-nim-api-key-here
NIM_API_KEY=your-nim-api-key-here
NIM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=500

# Embeddings — local sentence-transformers, no API key, downloads ~80MB on first run
# If wrong model: FAISS dim mismatch on load (deletes index and recreates)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# FAISS Vector Store — persist dir survives container restart via volume agents/data:/app/data
# If CHROMA_PERSIST_DIR wrong: re-seeds 20 docs on each start (FAISS index lost)
CHROMA_PERSIST_DIR=./data/chroma
COLLECTION_NAME=adaptiveai_knowledge
TOP_K=3

# Server
HOST=0.0.0.0
PORT=8002
